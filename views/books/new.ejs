<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新規登録画面</title>
</head>
<body>
    <h1>本新規登録画面</h1>
    <form action="/book/new" method="post">
        <div>
            <label for="name">題名</label>
            <input type="text" name="book[name]" id="name">
        </div>
        <div>
            <label for="author">著者</label>
            <input type="text" name="book[author]" id="author">
        </div>
        <button>登録</button>
    </form>
    
</body>
</html>