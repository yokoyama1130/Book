<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>編集画面</title>
</head>
<body>
    <h1>編集画面</h1>
    <form action="/books/<%= book._id %>/edit?_method=put" method="post">
        <div>
            <label for="name">題名</label>
            <input type="text" name="book[name]" id="name" value="<%= book.name %>">
        </div>
        <div>
            <label for="author">著者</label>
            <input type="text" name="book[author]" id="author" value="<%= book.author %>">
        </div>
        <button>編集する</button>
    </form>
    
</body>
</html>